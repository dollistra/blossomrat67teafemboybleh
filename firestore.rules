rules_version = '2';

// Visitors can only read the live server numbers. Applications are handled by the Discord bot (with a Discord login), never by this database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /siteConfig/serverStats {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
